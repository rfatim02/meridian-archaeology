        FRAME@{ label: "<span style=\"padding-left:\">1. FRAME<br></span><span style=\"padding-left:\"><br></span><span style=\"padding-left:\">Field-station telemetry<br></span><span style=\"padding-left:\"><br></span><span style=\"padding-left:\">44-byte binary frame<br></span><span style=\"padding-left:\"><br></span><span style=\"padding-left:\">Station: GUELPH<br></span><span style=\"padding-left:\">Year: 2025<br></span><span style=\"padding-left:\">DOY: 100<br></span><span style=\"padding-left:\"><br></span><span style=\"padding-left:\">Contains:<br></span><span style=\"padding-left:\">• MRD1 magic<br></span><span style=\"padding-left:\">• Station ID<br></span><span style=\"padding-left:\">• Year<br></span><span style=\"padding-left:\">• DOY<br></span><span style=\"padding-left:\">• TMAX<br></span><span style=\"padding-left:\">• TMIN<br></span><span style=\"padding-left:\">• RAIN<br></span><span style=\"padding-left:\">• SRAD<br></span><span style=\"padding-left:\">• RH<br></span><span style=\"padding-left:\">• WIND<br></span><span style=\"padding-left:\">• Flags<br></span><span style=\"padding-left:\">• CRC16</span>" }
        INGEST@{ label: "<span style=\"color:\">2. TELEMETRY INGEST</span><span style=\"color:\"><br></span><span style=\"color:\">mrd_ingest — C</span><span style=\"color:\"><br></span><span style=\"color:\"><br></span><span style=\"color:\">READ<br></span><span style=\"color:\">mrd_spool_next()<br></span><span style=\"color:\">• Reads the next raw telemetry frame</span><span style=\"color:\"><br></span><span style=\"color:\"><br></span><span style=\"color:\">PARSE &amp; VERIFY<br></span><span style=\"color:\">mrd_packet_parse()<br></span><span style=\"color:\">• Check MRD1 magic<br></span><span style=\"color:\">• Verify CRC16</span><span style=\"color:\"><br></span><span style=\"color:\"><br></span><span style=\"color:\">DECODE<br></span><span style=\"color:\">mrd_decode()<br></span><span style=\"color:\">• Convert raw sensor values<br></span><span style=\"color:\">• Divide values by 100<br></span><span style=\"color:\">• Produce engineering units</span><span style=\"color:\"><br></span><span style=\"color:\"><br></span><span style=\"color:\">QUALITY CHECK<br></span><span style=\"color:\">mrd_qc_check()<br></span>• Check physical sensor bounds <br>• Mark reading clean/suspect <br>• Record QC statistics <br>• Suspect reading is still stored (QC only counts it)" }
  end
